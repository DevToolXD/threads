# Optional: Firebase (free Spark plan). Copy to .env.local and fill in, then rebuild.
# These web config values are public identifiers; access is enforced by firebase/firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Set when building for GitHub Pages project sites (https://<user>.github.io/threads/).
# NEXT_PUBLIC_BASE_PATH=/threads
